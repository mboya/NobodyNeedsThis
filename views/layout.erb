<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= @page_title || 'Payment Simulator API' %></title>
  <style>
    :root {
      --bg: #0f1419;
      --surface: #1a2332;
      --border: #2d3a4d;
      --text: #e7ecf3;
      --muted: #8b9cb3;
      --accent: #22c55e;
      --accent-dim: #166534;
      --get: #3b82f6;
      --post: #22c55e;
      --admin: #f59e0b;
      --code-bg: #0a0e14;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .wrap { max-width: 920px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
    header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }
    header h1 { font-size: 1.75rem; font-weight: 600; letter-spacing: -0.02em; }
    header p { color: var(--muted); margin-top: 0.5rem; font-size: 0.95rem; }
    .badge {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      margin-right: 0.35rem;
    }
    .badge-demo { background: var(--accent-dim); color: var(--accent); }
    .badge-env { background: #1e3a5f; color: #93c5fd; }
    nav { margin-top: 1rem; display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.875rem; }
    main h2 {
      font-size: 1.15rem;
      margin: 2rem 0 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }
    main h2:first-of-type { border-top: none; padding-top: 0; margin-top: 0; }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1rem;
    }
    .card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.35rem; }
    .card .path {
      font-family: ui-monospace, 'SF Mono', Menlo, monospace;
      font-size: 0.85rem;
      color: var(--muted);
      margin-bottom: 0.75rem;
    }
    .method {
      display: inline-block;
      font-family: ui-monospace, monospace;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      margin-right: 0.5rem;
      vertical-align: middle;
    }
    .method-GET { background: rgba(59, 130, 246, 0.2); color: #93c5fd; }
    .method-POST { background: rgba(34, 197, 94, 0.2); color: #86efac; }
    .auth-tag { font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; }
    .auth-tag strong { color: var(--admin); }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin: 0.75rem 0; }
    th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-weight: 500; }
    pre {
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
      overflow-x: auto;
      font-size: 0.8rem;
      line-height: 1.5;
      margin-top: 0.75rem;
      position: relative;
    }
    code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; }
    .copy-btn {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      background: var(--border);
      border: none;
      color: var(--text);
      font-size: 0.7rem;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      cursor: pointer;
    }
    .copy-btn:hover { background: #3d4f66; }
    .alert {
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.35);
      border-radius: 8px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
    }
    .info {
      background: rgba(59, 130, 246, 0.08);
      border: 1px solid rgba(59, 130, 246, 0.25);
      border-radius: 8px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
    }
    footer { margin-top: 3rem; color: var(--muted); font-size: 0.8rem; }
  </style>
</head>
<body>
  <main class="wrap">
    <%= yield %>
  </main>
  <script>
    const genBtn = document.getElementById('generate-key-btn');
    if (genBtn) {
      genBtn.addEventListener('click', async () => {
        genBtn.disabled = true;
        genBtn.textContent = 'Generating…';
        try {
          const res = await fetch('/api/keys', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
          const data = await res.json();
          if (!res.ok) throw new Error(data.message || res.statusText);
          const pre = document.getElementById('generated-key');
          pre.style.display = 'block';
          pre.querySelector('code').textContent = data.api_key;
          genBtn.textContent = 'Copy key';
          genBtn.disabled = false;
          genBtn.onclick = () => navigator.clipboard.writeText(data.api_key);
        } catch (e) {
          genBtn.textContent = 'Failed — try again';
          genBtn.disabled = false;
          alert(e.message);
        }
      });
    }
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const pre = btn.parentElement.querySelector('code');
        navigator.clipboard.writeText(pre.textContent).then(() => {
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
        });
      });
    });
  </script>
</body>
</html>
