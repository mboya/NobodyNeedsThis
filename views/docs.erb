<% @page_title = 'Payment Simulator — API Docs' %>
<header>
  <span class="badge badge-demo">Demo only</span>
  <span class="badge badge-env"><%= @environment %></span>
  <h1>Payment Simulator API</h1>
  <p>Fake M-Pesa &amp; bank transfer API for local dev, demos, and webhook testing. Not for real money.</p>
  <nav>
    <a href="#auth">Authentication</a>
    <a href="#endpoints">Endpoints</a>
    <a href="#webhooks">Webhooks</a>
    <a href="#mpesa-codes">M-Pesa codes</a>
    <a href="/api/health">Health JSON</a>
  </nav>
</header>

<% if @auth_required %>
<section class="alert" id="auth">
  <strong>Authentication required.</strong>
  Send your API key on every request (except <code>/api/health</code> and this page):
  <ul style="margin: 0.75rem 0 0 1.25rem;">
    <li><code>Authorization: Bearer YOUR_API_KEY</code></li>
    <li><code>X-API-Key: YOUR_API_KEY</code></li>
  </ul>
  Admin routes (<code>POST /api/payments/reset</code>) need <code>ADMIN_API_KEY</code> in production.
</section>
<% else %>
<section class="info" id="auth">
  <strong>Local mode — no API key required.</strong>
  Set <code>API_KEY</code> in your environment to test production-style auth locally.
</section>
<% end %>

<section class="info">
  <strong>Base URL:</strong> <code><%= @base_url %></code><br>
  All requests use <code>Content-Type: application/json</code> unless noted.
</section>

<h2 id="endpoints">Endpoints</h2>

<% @endpoints.each do |ep| %>
<article class="card">
  <h3>
    <span class="method method-<%= ep[:method] %>"><%= ep[:method] %></span>
    <%= ep[:title] %>
  </h3>
  <div class="path"><%= ep[:path] %></div>
  <p class="auth-tag">
    <% if ep[:auth] == :admin %>
      <strong>Admin key</strong> required in production
    <% elsif ep[:auth] %>
      API key required
    <% else %>
      Public
    <% end %>
  </p>
  <p><%= ep[:description] %></p>

  <% if ep[:params]&.any? %>
  <table>
    <thead><tr><th>Field</th><th></th><th>Notes</th></tr></thead>
    <tbody>
      <% ep[:params].each do |name, kind, notes| %>
      <tr>
        <td><code><%= name %></code></td>
        <td><%= kind %></td>
        <td><%= notes %></td>
      </tr>
      <% end %>
    </tbody>
  </table>
  <% end %>

  <% if ep[:body] %>
  <pre><button type="button" class="copy-btn">Copy</button><code><%= ep[:curl_example] %></code></pre>
  <% end %>

  <% if ep[:response] %>
  <p style="margin-top:0.75rem;font-size:0.85rem;color:var(--muted);">Example response</p>
  <pre><code><%= ep[:response] %></code></pre>
  <% end %>
</article>
<% end %>

<h2 id="webhooks">Webhooks</h2>
<section class="card">
  <p>Include <code>callback_url</code> when starting a payment. When the flow completes, the simulator POSTs JSON to that URL (same shape as real providers).</p>
  <p style="margin-top:0.75rem;">For local testing, run <code>ruby webhook_receiver.rb</code> on port <strong>4567</strong> and use:</p>
  <ul style="margin: 0.5rem 0 0 1.25rem; font-size: 0.9rem;">
    <li><code>http://localhost:4567/webhooks/mpesa</code> (local receiver)</li>
    <li><code>…/webhooks/bank</code></li>
  </ul>
  <p style="margin-top:0.75rem;font-size:0.85rem;color:var(--muted);">
    On serverless hosts (e.g. Vercel), prefer <code>auto_complete: false</code> and call the manual callback endpoints, or use a public inbox like webhook.site.
  </p>
</section>

<h2 id="mpesa-codes">M-Pesa result codes</h2>
<section class="card">
  <table>
    <thead><tr><th>Code</th><th>Meaning</th></tr></thead>
    <tbody>
      <% @mpesa_codes.each do |code, label| %>
      <tr><td><code><%= code %></code></td><td><%= label %></td></tr>
      <% end %>
    </tbody>
  </table>
</section>

<footer>
  Payment Simulator — built for testing only.
  See the project README for Rails integration examples.
</footer>
