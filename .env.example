# Production (Vercel / self-hosted)
RACK_ENV=production

# Optional: fixed keys for operators or CI (comma-separated for rotation)
# API_KEY=your-secret-api-key
# API_KEYS=key-one,key-two

# Self-service keys for public demo (default: true)
ENABLE_API_KEY_REGISTRATION=true

# Persist keys across serverless instances (recommended on Vercel)
# Create a free database at https://upstash.com — REST API, no gem required
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Admin-only routes (reset, debug) in production
# ADMIN_API_KEY=your-admin-secret

# CORS — comma-separated allowed origins (required in production for browser clients)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Key registration rate limit (per IP)
KEY_REGISTRATION_RATE_LIMIT=10
KEY_REGISTRATION_RATE_WINDOW=3600

# Simulator behaviour
SUCCESS_RATE=0.95

# Rate limits (per client IP, per process)
RATE_LIMIT_MAX=60
RATE_LIMIT_WEBHOOK_MAX=20
RATE_LIMIT_WINDOW=60

# HTTPS guard (Vercel sets X-Forwarded-Proto; disable only for local prod testing)
ENFORCE_HTTPS=true

# Local development toggles
# ENABLE_DEBUG_ENDPOINTS=true
# ENABLE_RESET_ENDPOINT=true

# Vercel sets VERCEL=1 automatically; TLS is terminated at the edge.
# Deploy: vercel --prod  (or connect GitHub repo in Vercel dashboard)
